<?xml version="1.0" encoding="UTF-8"?>
<!--
    Tesco Extra Yeovil, APPROACH route (UK).

    Queensway Place, Yeovil, Somerset
    Store centre: 50.9414, -2.6325

    WHAT THIS TESTS: region re-priming after a location jump. Monitoring only
    covers the ~20 nearest stores, so if the device (or previous simulation)
    was in Auckland, NO UK regions are monitored when this route starts. The
    first waypoints teleport the location to Somerset; the significant-change
    handler must re-prime the monitored set to UK stores BEFORE the boundary
    crossing arrives, or nothing fires. The run-in is deliberately longer
    (about 3 km, ~80 s) to give the re-prime time to happen. If Glenfield
    passes and this fails, the re-prime path is your flake.

    Also note Boots Yeovil / Superdrug Yeovil are ~180 m away with fully
    overlapping circles — expect multiple fires near arrival.

    USE: Xcode, Debug, Simulate Location, TescoYeovil-Approach
-->
<gpx version="1.1" creator="Frydge" xmlns="http://www.topografix.com/GPX/1/1">

    <wpt lat="50.9144" lon="-2.6325">
        <name>Approach 1, outside 3.0 km (re-prime window)</name>
        <time>2026-08-02T09:00:00Z</time>
    </wpt>

    <wpt lat="50.9184" lon="-2.6325">
        <name>Approach 2, outside 2.6 km</name>
        <time>2026-08-02T09:00:15Z</time>
    </wpt>

    <wpt lat="50.9224" lon="-2.6325">
        <name>Approach 3, outside 2.1 km</name>
        <time>2026-08-02T09:00:30Z</time>
    </wpt>

    <wpt lat="50.9274" lon="-2.6325">
        <name>Approach 4, outside 1.6 km</name>
        <time>2026-08-02T09:00:45Z</time>
    </wpt>

    <wpt lat="50.9324" lon="-2.6325">
        <name>Approach 5, outside 1.0 km</name>
        <time>2026-08-02T09:01:00Z</time>
    </wpt>

    <wpt lat="50.9344" lon="-2.6325">
        <name>Approach 6, outside 780 m, last outside</name>
        <time>2026-08-02T09:01:10Z</time>
    </wpt>

    <wpt lat="50.9364" lon="-2.6325">
        <name>Approach 7, INSIDE 560 m, crossing</name>
        <time>2026-08-02T09:01:20Z</time>
    </wpt>

    <wpt lat="50.9394" lon="-2.6325">
        <name>Approach 8, inside 220 m</name>
        <time>2026-08-02T09:01:30Z</time>
    </wpt>

    <wpt lat="50.9414" lon="-2.6325">
        <name>Tesco Extra Yeovil, arrived</name>
        <time>2026-08-02T09:01:40Z</time>
    </wpt>

</gpx>
