    <!--
        CloudKit mirroring rules this model must obey (NSPersistentCloudKitContainer):
          1. Every attribute is optional, or has a default value.
          2. Every relationship is optional and has an inverse.
          3. No unique constraints anywhere.
          4. No "Deny" delete rules.
        Breaking any of these makes loadPersistentStores fail at launch.

        Deletion is a SYNCED FACT here (deletedAt), not a local UserDefaults
        tombstone — that design is what let deleted fridge items resurrect.
    -->
    <entity name="FrydgeRecipe" representedClassName="FrydgeRecipe" syncable="YES" codeGenerationType="class">
        <attribute name="cloudKitID" optional="YES" attributeType="String"/>
        <attribute name="ingredients" optional="YES" attributeType="String"/>
