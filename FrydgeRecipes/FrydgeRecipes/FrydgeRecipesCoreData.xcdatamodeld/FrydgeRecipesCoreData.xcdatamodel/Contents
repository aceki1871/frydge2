    </entity>
    <entity name="CDFridgeItem" representedClassName="CDFridgeItem" syncable="YES" codeGenerationType="class">
        <attribute name="id" optional="YES" attributeType="UUID" usesScalarValueType="NO"/>
        <attribute name="name" optional="YES" attributeType="String" defaultValueString=""/>
        <attribute name="quantity" optional="YES" attributeType="String" defaultValueString=""/>
        <attribute name="unit" optional="YES" attributeType="String" defaultValueString=""/>
        <attribute name="expirationDate" optional="YES" attributeType="Date" usesScalarValueType="NO"/>
        <attribute name="location" optional="YES" attributeType="String" defaultValueString="Fridge"/>
        <!-- Set&lt;String&gt; is not CloudKit-mirrorable; stored as a JSON array string. -->
        <attribute name="dietaryTagsJSON" optional="YES" attributeType="String" defaultValueString="[]"/>
        <attribute name="lifecycleRaw" optional="YES" attributeType="String" defaultValueString="fridge"/>
        <attribute name="quantityUsed" optional="YES" attributeType="Double" defaultValueString="0.0" usesScalarValueType="YES"/>
        <attribute name="createdAt" optional="YES" attributeType="Date" usesScalarValueType="NO"/>
        <attribute name="updatedAt" optional="YES" attributeType="Date" usesScalarValueType="NO"/>
        <!-- Soft delete. Non-nil = deleted. Replaces the per-device UserDefaults tombstones. -->
        <attribute name="deletedAt" optional="YES" attributeType="Date" usesScalarValueType="NO"/>
        <relationship name="photos" optional="YES" toMany="YES" deletionRule="Cascade" destinationEntity="CDItemPhoto" inverseName="fridgeItem" inverseEntity="CDItemPhoto"/>
    </entity>
    <entity name="CDShoppingItem" representedClassName="CDShoppingItem" syncable="YES" codeGenerationType="class">
        <attribute name="id" optional="YES" attributeType="UUID" usesScalarValueType="NO"/>
